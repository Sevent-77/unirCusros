<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.UnirCursos" parent="Theme.Material3.DayNight.NoActionBar">
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="colorPrimary">@color/unir_blue</item>
        <item name="colorOnPrimary">@color/unir_white</item>

        <item name="colorSecondary">@color/unir_blue_dark</item>
        <item name="colorOnSecondary">@color/unir_white</item>

        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorOnBackground">@color/light_on_background</item>

        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_on_surface</item>

        <item name="android:windowBackground">@color/light_background</item>
        <item name="android:statusBarColor">@color/unir_blue_dark</item>
        <item name="android:navigationBarColor">@color/unir_blue_dark</item>

        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.UnirCursos" parent="Base.Theme.UnirCursos" />
</resources>